# NEXUS AI backend environment example
# Copy to backend/.env and adjust as needed

# Local OpenAI-compatible server (Ollama example: start ollama, then set to http://localhost:11434/v1)
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_API_KEY=ollama
LOCAL_MODEL_DEFAULT_MODEL=llama3

# Online/OpenAI-compatible cloud
ONLINE_MODEL_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo
